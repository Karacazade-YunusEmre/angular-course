# Satır sonlarını normalize et — Windows + Linux karışık çalışma için.
# Depoda her şey LF olarak saklanır; checkout'ta platforma göre ayarlanır.
* text=auto eol=lf

# Windows'a özel script'ler CRLF kalmalı
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# İkili dosyalara dokunma
*.png  binary
*.jpg  binary
*.pdf  binary
*.zip  binary
